    "words": {
      "常备 · 待填写词类": [{"local": "待核对当地词", "zh": "对应中文", "roman": "", "english": "待核对英语词"}],
      "待填写回答场景": [{"local": "待核对常见回答", "zh": "对应中文", "roman": "", "english": "待核对英语回答"}]
    },
    "editorial_sources": {
      "restaurant_official": {"title": "待替换为准确分店菜单与预约资料", "url": "https://example.com/replace-restaurant-source", "checked": "2000-01-01"},
      "district_official": {"title": "待替换为来源标题", "url": "https://example.com/replace-with-actual-source", "checked": "2000-01-01", "claims": ["待填写该页面实际支持的事实"]} // 日期仅演示格式，正式内容必须替换为实际查阅日期
    },
    "section_sources": {
      "areas:district": {"0": ["district_official"]},
      "experiences:district": {"0": ["district_official"]}
    } // 行索引从0起；portrait/stays/food_types/snacks/culture/shopping/notes:<主题>等正文也需各自真实来源，不可复用无关页面凑覆盖
  },
  "place-photos.json": {
    "district": {"src": "media/district.jpg", "page": "https://commons.wikimedia.org/", "caption": "待核对的主体",
