      "duration": "待填写", "desc": "待采编", "walk": "待采编", "tip": "待核查",
      "identityScope": "area", // 具体场馆/分店用 venue；省略也按 venue 检查
      "url": "https://www.google.com/maps/search/?api=1&query=REPLACE_WITH_ENCODED_PLACE_AND_CITY",
      "urlKind": "map" // 可以是 official / source / map；这里不冒充官网
    }, {
      "id": "restaurant", "name": "待填写店名", "local": "待填写当地名称", "area": "待填写片区",
      "kind": "美食", "where": "待填写准确地址与分店", "duration": "待填写", "desc": "待采编", "tip": "待核查",
      "url": "https://www.google.com/maps/search/?api=1&query=REPLACE_WITH_ENCODED_RESTAURANT_AND_CITY", "urlKind": "map"
    }],
    "areas": [{
      "id": "district", "name": "待填写", "en": "DISTRICT NAME", "photo": "spread-district",
      "route": "待填写区域走法", "tip": "待填写区域提示", "ids": ["district", "restaurant"], "day": 0
    }], // 0=第1天；area.id 在全书唯一
    "days": [{
      "id": "d1", "area": "待填写当天区域", "title": "待填写当天标题", "lead": "待采编当天导语",
      "move": "待核查交通", "guard": "待采编天气取舍", "budget": "待核查预算", "photo": "待采编摄影提示",
      "periods": ["待采编上午", "待采编下午", "待采编晚间"], "shopping": [],
      "dining": ["restaurant"], // 当天用餐候选，不自动改变 stops
      "stops": [["上午", "district", "待填写"], ["午间", "restaurant", "待填写"]],
      "schedules": {"standard": {
        "district": {"time": "09:00", "duration": 60, "guard": "待核查"},
        "restaurant": {"time": "12:00", "duration": 60, "guard": "待核查"}
      }},
      "transfers": {"district>restaurant": {"minutes": 20, "label": "待核查步行或公共交通"}}
      // 这是结构示例。完整手册还需按实际内容门槛编写 alternatives、walk、photoPlan 等。
    }],
    "sources": {}
  },
  "editorial-content.json": {
    "portrait": [["待采编城市观察标题", "待采编正文"]], // 每行恰好两个字符串
    "stays": [["待采编住宿区域", "待核查住处取舍"]],
    "area_sections": {
