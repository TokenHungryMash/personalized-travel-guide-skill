    "notes": {"待填写实用主题": [["待采编条目", "待核查正文"]]},
    "reservations": [["待核查预约事项", "待核查时间", "待核查渠道"]],
    "preparation": [{"title": "提前办理与预订", "items": [{"id": "prep-reservation", "title": "待填写具体任务", "detail": "待说明操作入口、适用条件与完成标准", "priority": "按需", "sources": ["restaurant_official"]}]}], // 正式内容按当地需要组织三阶段；旧 checklist 仅作兼容
    "languageScenes": [{"id": "scene", "label": "待填写场景", "phrases": "待填写使用场景", "glossary": "常备 · 待填写词类", "replies": "待填写回答场景"}],
    // 每组恰好归属一个场景；没有某类内容就省略该引用。下面示范非英语目的地。
    // 英语目的地（edition.lang=en/en-*）改用：phrases 分组里的 {"id":"dining-bill","local":"Could we have the bill, please?","zh":"请结账。"}
    // words 分组里的 {"local":"Service included","zh":"已含服务费"}；省略 english，不填空字符串，不另做一套英语切换。
