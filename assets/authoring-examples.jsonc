      "areaId": "district", "tone": "blue", "words": ["DISTRICT", "WALK."],
      "title": "待采编", "copy": "待采编具体体验", "extra": "待采编观察线索与适用条件",
      "place": "district", "label": "打开该地点"
    }], // 与 areas 同序且一一对应；place 必须在对应 area.ids 中
